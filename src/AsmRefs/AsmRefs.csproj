<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads assembly references from a built mod DLL without loading or executing it.
       System.Reflection.Metadata ships in the shared framework, so there are no packages and no restore step. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>asmrefs</AssemblyName>
    <RootNamespace>AsmRefs</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
